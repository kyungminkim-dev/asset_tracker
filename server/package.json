{
  "name": "asset-tracker-server",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "type": "module",
  "dependencies": {
    "fastify": "^5.12.7",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
