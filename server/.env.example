# 서버 포트
PORT=4000

# 모바일 앱이 서버에 접근할 때 쓰는 토큰 (아무 긴 랜덤 문자열)
APP_TOKEN=change-me-to-a-long-random-string

# 증권사 API 키를 DB에 암호화해 저장할 때 쓰는 키 (32바이트 base64)
# 생성: npm run gen-key
ENCRYPTION_KEY=

# SQLite 파일 경로
DB_PATH=./data/asset-tracker.db

# 매일 자동 스냅샷 시각 (cron, Asia/Seoul 기준). 기본: 매일 16:10 (국내장 마감 후)
SNAPSHOT_CRON=10 16 * * *
