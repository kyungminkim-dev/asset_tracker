# 서버 포트
PORT=4000

# 외부에서 접근 가능한 서버 주소 (OAuth 콜백에 사용)
# 구글은 https 또는 localhost 만 허용하므로, 폰에서 테스트하려면 터널(예: cloudflared)을 쓰세요.
PUBLIC_URL=https://your-server.example.com

# 증권사 API 키를 DB에 암호화해 저장할 때 쓰는 키 (32바이트 base64)
# 생성: npm run gen-key
ENCRYPTION_KEY=

# SQLite 파일 경로
DB_PATH=./data/asset-tracker.db

# 매일 자동 스냅샷 시각 (cron, Asia/Seoul 기준). 기본: 매일 16:10 (국내장 마감 후)
SNAPSHOT_CRON=10 16 * * *

# 로그인 유지 기간(일)
SESSION_DAYS=90

# 로그인 후 돌아갈 수 있는 앱 주소 접두사. 배포 시에는 exp:// 를 빼세요.
APP_REDIRECT_PREFIXES=assettracker://,exp://

# --- 구글 로그인 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID, 유형: 웹 애플리케이션)
# 승인된 리디렉션 URI: {PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 카카오 로그인 (Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키)
# 카카오 로그인 활성화 후 Redirect URI: {PUBLIC_URL}/auth/kakao/callback
# 보안 > Client Secret 이 켜져 있으면(기본값) 값을 넣으세요.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# --- 약관 · 개인정보 처리방침 (server/legal/*.md 에 채워지는 값)
# 비워두면 문서에 노란색 "입력 필요" 표시와 함께 초안 안내가 붙습니다.
# 문서는 {PUBLIC_URL}/legal/terms, /legal/privacy, /legal/consent 로 공개됩니다.
LEGAL_SERVICE_NAME=자산 트래커
# 운영자. 예: 홍길동 (개인) 또는 주식회사 ○○
LEGAL_OPERATOR=
# 문의·개인정보 관련 연락처 (공개됩니다)
LEGAL_CONTACT_EMAIL=
# 개인정보 보호책임자 이름
LEGAL_PRIVACY_OFFICER=
# 서버 호스팅 업체. 예: Amazon Web Services
LEGAL_HOSTING=
# 서버 위치. 예: 대한민국 / 미국
LEGAL_SERVER_LOCATION=
# 시행일. 예: 2026-11-01
LEGAL_EFFECTIVE_DATE=

# 개발용 테스트 로그인 (구글/카카오 키 없이 시뮬레이터에서 테스트할 때)
# 누구나 같은 테스트 계정으로 들어올 수 있으므로 배포 서버에서는 절대 켜지 마세요.
DEV_LOGIN=false
